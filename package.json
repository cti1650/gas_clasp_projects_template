{
  "name": "gas_clasp_projects_template",
  "version": "0.0.1",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init-serve": "clasp login --no-localhost",
    "lint": "eslint \"./projects/**/*.{js,ts}\" --fix --max-warnings 65",
    "lint:ci": "eslint \"./projects/**/*.{js,ts}\" --max-warnings 65",
    "format": "prettier --write \"./projects/**/*.{js,ts}\"",
    "format:ci": "prettier --check \"./projects/**/*.{js,ts}\"",
    "test": "node --test \"projects/**/*.test.js\"",
    "prepare": "simple-git-hooks",
    "audit-fix": "npm audit fix",
    "push-all": "node scripts/clasp-runner.js push --force",
    "push": "node scripts/clasp-runner.js push-updated --force",
    "push-dir": "node scripts/clasp-runner.js push-dir --force",
    "pull-all": "node scripts/clasp-runner.js pull",
    "pull": "node scripts/clasp-runner.js pull",
    "pull-dir": "node scripts/clasp-runner.js pull-dir",
    "open-dir": "node scripts/clasp-runner.js open-dir",
    "clasp": "node scripts/clasp-runner.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/google-apps-script": "^2.0.8",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "globals": "^17.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "secretlint": "^13.0.5",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*": [
      "npx secretlint"
    ]
  }
}
